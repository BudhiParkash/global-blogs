---
import { SITE_CATEGORIES, SITE_TAGLINE, SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header class="site-header">
	<div class="shell header-shell">
		<div class="brand-block">
			<a class="brand-mark" href="/" aria-label={`${SITE_TITLE} home`}>
				<span class="brand-kicker">Editorial</span>
				<strong>{SITE_TITLE}</strong>
			</a>
			<p>{SITE_TAGLINE}</p>
		</div>

		<nav class="main-nav" aria-label="Primary">
			<HeaderLink href="/">Home</HeaderLink>
			{SITE_CATEGORIES.map((item) => (
				<HeaderLink href={item.href}>{item.label}</HeaderLink>
			))}
			<HeaderLink href="/tools">Tools</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
			<HeaderLink href="/contact-us">Contact</HeaderLink>
		</nav>

		<!-- Fix 12: Pagefind site search — opens a modal, keyboard shortcut Cmd/Ctrl+K -->
		<button class="search-trigger" type="button" id="search-trigger" aria-label="Search articles">
			<svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.6-3.6"/></svg>
			<span>Search</span>
			<kbd>⌘K</kbd>
		</button>
	</div>
</header>

<dialog class="search-modal" id="search-modal" aria-label="Search GlobalsBlog">
	<div class="search-modal-inner">
		<div class="search-modal-top">
			<p>Search articles</p>
			<button type="button" id="search-close" aria-label="Close search">&times;</button>
		</div>
		<div id="pagefind-search"></div>
		<p class="search-hint">Press <kbd>Esc</kbd> to close</p>
	</div>
</dialog>
<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 20;
		background: rgba(248, 243, 236, 0.88);
		backdrop-filter: blur(16px);
		border-bottom: 1px solid var(--line);
	}

	.header-shell {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 2rem;
		padding-top: 1rem;
		padding-bottom: 1rem;
	}

	.brand-block {
		display: grid;
		gap: 0.4rem;
	}

	.brand-mark {
		display: inline-flex;
		flex-direction: column;
		gap: 0.2rem;
		text-decoration: none;
		color: var(--ink-strong);
	}

	.brand-kicker {
		font-size: 0.72rem;
		letter-spacing: 0.22em;
		text-transform: uppercase;
		color: var(--accent);
	}

	.brand-mark strong {
		font-size: clamp(1.2rem, 2vw, 1.7rem);
		line-height: 1;
	}

	.brand-block p {
		margin: 0;
		max-width: 32rem;
		font-size: 0.92rem;
		line-height: 1.5;
		color: var(--muted);
	}

	.main-nav {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: flex-end;
		gap: 0.45rem;
	}

	@media (max-width: 920px) {
		.header-shell {
			align-items: flex-start;
			flex-direction: column;
		}

		.main-nav {
			justify-content: flex-start;
		}
	}

	@media (max-width: 640px) {
		.site-header {
			position: static;
		}

		.header-shell {
			padding-top: 0.85rem;
			padding-bottom: 0.85rem;
		}
	}

	/* Fix 12: search trigger + modal */
	.search-trigger {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		flex: 0 0 auto;
		min-height: 40px;
		padding: 0.4rem 0.9rem;
		border: 1.5px solid var(--line);
		border-radius: 999px;
		background: var(--card);
		color: var(--muted);
		font-size: 0.86rem;
		font-weight: 700;
		cursor: pointer;
		transition: border-color 180ms ease, color 180ms ease;
	}

	.search-trigger:hover {
		border-color: var(--accent);
		color: var(--ink-strong);
	}

	.search-trigger kbd {
		font-family: inherit;
		font-size: 0.7rem;
		border: 1px solid var(--line);
		border-radius: 6px;
		padding: 0.1rem 0.35rem;
		color: var(--muted);
		background: rgba(255, 253, 248, 0.9);
	}

	.search-modal {
		width: min(640px, calc(100vw - 2rem));
		border: 1px solid var(--line);
		border-radius: var(--radius-lg);
		background: var(--surface-strong, #fffdf8);
		box-shadow: var(--shadow);
		padding: 0;
		margin: auto;
	}

	.search-modal::backdrop {
		background: rgba(31, 26, 23, 0.45);
		backdrop-filter: blur(3px);
	}

	.search-modal-inner {
		padding: 1.2rem 1.4rem 1.4rem;
	}

	.search-modal-top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 0.9rem;
	}

	.search-modal-top p {
		margin: 0;
		font-size: 0.78rem;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		font-weight: 700;
		color: var(--muted);
	}

	.search-modal-top button {
		border: 0;
		background: transparent;
		font-size: 1.5rem;
		line-height: 1;
		color: var(--muted);
		cursor: pointer;
	}

	.search-modal-top button:hover {
		color: var(--ink-strong);
	}

	.search-hint {
		margin: 0.9rem 0 0;
		font-size: 0.78rem;
		color: var(--muted);
	}

	.search-hint kbd {
		font-family: inherit;
		border: 1px solid var(--line);
		border-radius: 6px;
		padding: 0.05rem 0.3rem;
	}

	/* Pagefind UI theming via its CSS custom properties */
	#pagefind-search {
		--pagefind-ui-primary: var(--accent-strong);
		--pagefind-ui-text: var(--ink);
		--pagefind-ui-background: var(--surface-strong, #fffdf8);
		--pagefind-ui-border: var(--line);
		--pagefind-ui-border-radius: 12px;
		--pagefind-ui-font: inherit;
	}

	@media (max-width: 920px) {
		.search-trigger kbd {
			display: none;
		}
	}
</style>

<script>
	// Fix 12: lazy-load the Pagefind UI bundle the first time search opens.
	// /pagefind/* is generated by `pagefind --site dist` after `astro build`,
	// so in `astro dev` the modal shows a graceful notice instead.
	const modal = document.getElementById('search-modal') as HTMLDialogElement | null;
	const trigger = document.getElementById('search-trigger');
	const closeBtn = document.getElementById('search-close');
	let pagefindLoaded = false;

	async function loadPagefindUI() {
		if (pagefindLoaded) return;
		pagefindLoaded = true;
		try {
			const css = document.createElement('link');
			css.rel = 'stylesheet';
			css.href = '/pagefind/pagefind-ui.css';
			document.head.appendChild(css);

			// Plain script injection (not import()) so the bundler never tries to
			// resolve /pagefind/*, which only exists after `pagefind --site dist`.
			await new Promise((resolve, reject) => {
				const script = document.createElement('script');
				script.src = '/pagefind/pagefind-ui.js';
				script.onload = resolve;
				script.onerror = reject;
				document.head.appendChild(script);
			});
			// Pagefind derives URLs from dist folders (/auto/slug/), but our
			// canonical URLs have no trailing slash — strip it (also before
			// #anchors in sub-results) so search links match the canonicals.
			const stripSlash = (url: string) => url.replace(/\/+(#|\?|$)/, '$1') || '/';

			// @ts-expect-error PagefindUI is attached to window by the script above
			new window.PagefindUI({
				element: '#pagefind-search',
				showSubResults: true,
				showImages: false,
				processResult: (result: { url?: string; sub_results?: { url?: string }[] }) => {
					if (result?.url) result.url = stripSlash(result.url);
					result?.sub_results?.forEach((sub) => {
						if (sub?.url) sub.url = stripSlash(sub.url);
					});
					return result;
				},
			});
		} catch {
			const mount = document.getElementById('pagefind-search');
			if (mount) mount.innerHTML = '<p style="color:var(--muted)">Search index not built yet — run <code>npm run build</code>.</p>';
		}
	}

	function openSearch() {
		if (!modal) return;
		loadPagefindUI();
		modal.showModal();
		(modal.querySelector('input') as HTMLInputElement | null)?.focus();
	}

	trigger?.addEventListener('click', openSearch);
	closeBtn?.addEventListener('click', () => modal?.close());

	// Close when clicking the backdrop (outside the inner panel)
	modal?.addEventListener('click', (event) => {
		if (event.target === modal) modal.close();
	});

	// Keyboard shortcut: Cmd+K (macOS) / Ctrl+K
	document.addEventListener('keydown', (event) => {
		if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
			event.preventDefault();
			if (modal?.open) modal.close();
			else openSearch();
		}
	});
</script>
