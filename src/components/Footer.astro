---

<footer class="site-footer">
	<div class="shell footer-shell">
		<div>
			<p class="footer-eyebrow">Global editorial platform</p>
			<p class="footer-brand"><strong>{SITE_TITLE}</strong></p>
			<p class="footer-copy">{SITE_DESCRIPTION}</p>
			<div class="footer-social">
				<p class="footer-social-label">Follow Us</p>
				<div class="footer-social-icons">
					{socialLinks.map((s) => (
						<a href={s.href} target="_blank" rel="noopener noreferrer" class="social-icon" aria-label={s.label} set:html={s.svg} />
					))}
				</div>
			</div>
		</div>

		<div>
			<h3>Browse</h3>
			<ul class="footer-links">
				<li><a href="/">Latest Stories</a></li>
				{SITE_CATEGORIES.map((item) => (
					<li><a href={item.href}>{item.label}</a></li>
				))}
				<li><a href="/about">About</a></li>
				<li><a href="/contact-us">Contact Us</a></li>
			</ul>
		</div>

		<div>
			<h3>Legal</h3>
			<ul class="footer-links">
				{legalLinks.map((item) => (
					<li><a href={item.href}>{item.label}</a></li>
				))}
			</ul>
		</div>

		<div>
			<h3>Contact</h3>
			<ul class="footer-notes">
				<li><a href="mailto:contact@globalsblog.com">contact@globalsblog.com</a></li>
				<li>The Edge Tower, Ramprastha City, Sector 37D, Gurugram, Haryana, India</li>
				<li>Editorial and business inquiries welcome</li>
			</ul>
		</div>
	</div>

	<div class="shell footer-bottom">
		<p>&copy; {today.getFullYear()} {SITE_TITLE}. All rights reserved.</p>
	</div>
</footer>
<style>
	.site-footer {
		margin-top: 5rem;
		border-top: 1px solid var(--line);
		background:
			radial-gradient(circle at top left, rgba(210, 124, 67, 0.15), transparent 28rem),
			linear-gradient(180deg, rgba(255, 255, 255, 0.2), rgba(255, 255, 255, 0.65));
	}

	.footer-shell {
		display: grid;
		grid-template-columns: 1.35fr 1fr 1fr 1fr;
		gap: 2rem;
		padding-top: 3rem;
		padding-bottom: 2rem;
	}

	.footer-eyebrow,
	.footer-copy,
	.footer-bottom p,
	.footer-notes {
		color: var(--muted);
	}

	.footer-eyebrow {
		margin: 0 0 0.6rem;
		font-size: 0.8rem;
		letter-spacing: 0.2em;
		text-transform: uppercase;
	}

	.footer-brand {
		margin: 0 0 0.9rem;
		font-size: clamp(1.4rem, 2.5vw, 1.9rem);
		line-height: 1.08;
		letter-spacing: -0.03em;
		color: var(--ink-strong);
	}

	h3 {
		margin: 0 0 0.9rem;
	}

	.footer-copy {
		margin: 0;
		max-width: 28rem;
	}

	.footer-links,
	.footer-notes {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.6rem;
	}

	.footer-links a {
		text-decoration: none;
		color: var(--ink);
	}

	.footer-notes a {
		color: inherit;
		text-decoration: none;
	}

	.footer-links a:hover {
		color: var(--accent);
	}

	.footer-notes a:hover {
		color: var(--accent);
	}

	.footer-social {
		margin-top: 1.4rem;
	}

	.footer-social-label {
		margin: 0 0 0.6rem;
		font-size: 0.78rem;
		letter-spacing: 0.15em;
		text-transform: uppercase;
		color: var(--muted);
	}

	.footer-social-icons {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.social-icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.1rem;
		height: 2.1rem;
		border-radius: 50%;
		border: 1px solid var(--line);
		color: var(--muted);
		background: transparent;
		transition: color 0.18s, background 0.18s, border-color 0.18s, transform 0.18s;
		text-decoration: none;
	}

	.social-icon :global(svg) {
		width: 1rem;
		height: 1rem;
		flex-shrink: 0;
	}

	.social-icon:hover {
		color: var(--accent);
		border-color: var(--accent);
		background: rgba(210, 124, 67, 0.08);
		transform: translateY(-2px);
	}

	.footer-bottom {
		padding-top: 1rem;
		padding-bottom: 2rem;
		border-top: 1px solid var(--line);
	}

	.footer-bottom p {
		margin: 0;
		font-size: 0.95rem;
	}

	@media (max-width: 860px) {
		.footer-shell {
			grid-template-columns: 1fr;
			padding-top: 2.4rem;
		}
	}
</style>
