---
import { SITE_CATEGORIES, SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const today = new Date();
---

<footer class="site-footer">
	<div class="shell footer-shell">
		<div>
			<p class="footer-eyebrow">Global editorial platform</p>
			<h2>{SITE_TITLE}</h2>
			<p class="footer-copy">{SITE_DESCRIPTION}</p>
		</div>

		<div>
			<h3>Browse</h3>
			<ul class="footer-links">
				<li><a href="/">Latest Stories</a></li>
				{SITE_CATEGORIES.map((item) => (
					<li><a href={item.href}>{item.label}</a></li>
				))}
				<li><a href="/about">About</a></li>
			</ul>
		</div>

		<div>
			<h3>Publishing Focus</h3>
			<ul class="footer-notes">
				<li>Readable long-form layouts</li>
				<li>Category-led content discovery</li>
				<li>Search and social preview support</li>
			</ul>
		</div>
	</div>

	<div class="shell footer-bottom">
		<p>&copy; {today.getFullYear()} {SITE_TITLE}. All rights reserved.</p>
	</div>
</footer>
<style>
	.site-footer {
		margin-top: 5rem;
		border-top: 1px solid var(--line);
		background:
			radial-gradient(circle at top left, rgba(210, 124, 67, 0.15), transparent 28rem),
			linear-gradient(180deg, rgba(255, 255, 255, 0.2), rgba(255, 255, 255, 0.65));
	}

	.footer-shell {
		display: grid;
		grid-template-columns: 1.4fr 1fr 1fr;
		gap: 2rem;
		padding-top: 3rem;
		padding-bottom: 2rem;
	}

	.footer-eyebrow,
	.footer-copy,
	.footer-bottom p,
	.footer-notes {
		color: var(--muted);
	}

	.footer-eyebrow {
		margin: 0 0 0.6rem;
		font-size: 0.8rem;
		letter-spacing: 0.2em;
		text-transform: uppercase;
	}

	h2,
	h3 {
		margin: 0 0 0.9rem;
	}

	.footer-copy {
		margin: 0;
		max-width: 28rem;
	}

	.footer-links,
	.footer-notes {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.6rem;
	}

	.footer-links a {
		text-decoration: none;
		color: var(--ink);
	}

	.footer-links a:hover {
		color: var(--accent);
	}

	.footer-bottom {
		padding-top: 1rem;
		padding-bottom: 2rem;
		border-top: 1px solid var(--line);
	}

	.footer-bottom p {
		margin: 0;
		font-size: 0.95rem;
	}

	@media (max-width: 860px) {
		.footer-shell {
			grid-template-columns: 1fr;
			padding-top: 2.4rem;
		}
	}
</style>
