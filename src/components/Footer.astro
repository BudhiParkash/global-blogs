---
import { SITE_CATEGORIES, SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const today = new Date();
const legalLinks = [
	{ label: 'Privacy Policy', href: '/privacy-policy' },
	{ label: 'Terms & Conditions', href: '/terms-and-conditions' },
	{ label: 'Disclaimer', href: '/disclaimer' },
];
---

<footer class="site-footer">
	<div class="shell footer-shell">
		<div>
			<p class="footer-eyebrow">Global editorial platform</p>
			<p class="footer-brand"><strong>{SITE_TITLE}</strong></p>
			<p class="footer-copy">{SITE_DESCRIPTION}</p>
		</div>

		<div>
			<h3>Browse</h3>
			<ul class="footer-links">
				<li><a href="/">Latest Stories</a></li>
				{SITE_CATEGORIES.map((item) => (
					<li><a href={item.href}>{item.label}</a></li>
				))}
				<li><a href="/about">About</a></li>
				<li><a href="/contact-us">Contact Us</a></li>
			</ul>
		</div>

		<div>
			<h3>Legal</h3>
			<ul class="footer-links">
				{legalLinks.map((item) => (
					<li><a href={item.href}>{item.label}</a></li>
				))}
			</ul>
		</div>

		<div>
			<h3>Contact</h3>
			<ul class="footer-notes">
				<li><a href="mailto:contact@globalsblog.com">contact@globalsblog.com</a></li>
				<li>The Edge Tower, Ramprastha City, Sector 37D, Gurugram, Haryana, India</li>
				<li>Editorial and business inquiries welcome</li>
			</ul>
		</div>
	</div>

	<div class="shell footer-bottom">
		<p>&copy; {today.getFullYear()} {SITE_TITLE}. All rights reserved.</p>
	</div>
</footer>
<style>
	.site-footer {
		margin-top: 5rem;
		border-top: 1px solid var(--line);
		background:
			radial-gradient(circle at top left, rgba(210, 124, 67, 0.15), transparent 28rem),
			linear-gradient(180deg, rgba(255, 255, 255, 0.2), rgba(255, 255, 255, 0.65));
	}

	.footer-shell {
		display: grid;
		grid-template-columns: 1.35fr 1fr 1fr 1fr;
		gap: 2rem;
		padding-top: 3rem;
		padding-bottom: 2rem;
	}

	.footer-eyebrow,
	.footer-copy,
	.footer-bottom p,
	.footer-notes {
		color: var(--muted);
	}

	.footer-eyebrow {
		margin: 0 0 0.6rem;
		font-size: 0.8rem;
		letter-spacing: 0.2em;
		text-transform: uppercase;
	}

	.footer-brand {
		margin: 0 0 0.9rem;
		font-size: clamp(1.4rem, 2.5vw, 1.9rem);
		line-height: 1.08;
		letter-spacing: -0.03em;
		color: var(--ink-strong);
	}

	h3 {
		margin: 0 0 0.9rem;
	}

	.footer-copy {
		margin: 0;
		max-width: 28rem;
	}

	.footer-links,
	.footer-notes {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.6rem;
	}

	.footer-links a {
		text-decoration: none;
		color: var(--ink);
	}

	.footer-notes a {
		color: inherit;
		text-decoration: none;
	}

	.footer-links a:hover {
		color: var(--accent);
	}

	.footer-notes a:hover {
		color: var(--accent);
	}

	.footer-bottom {
		padding-top: 1rem;
		padding-bottom: 2rem;
		border-top: 1px solid var(--line);
	}

	.footer-bottom p {
		margin: 0;
		font-size: 0.95rem;
	}

	@media (max-width: 860px) {
		.footer-shell {
			grid-template-columns: 1fr;
			padding-top: 2.4rem;
		}
	}
</style>
