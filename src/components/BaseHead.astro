---
import '../styles/global.css';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

interface Props {
  title: string;
  description: string;
  image?: string;
  keywords?: string;

  articleDate?: string;
  articleModified?: string;
  authorName?: string;
  authorUrl?: string;
  authorBio?: string;
  authorAvatar?: string;
  category?: string;
  isArticle?: boolean;
  isAuthorProfile?: boolean;
  itemListItems?: { url: string; name?: string }[];
}

const {
  title,
  description,
  image,
  keywords,
  articleDate,
  articleModified,
  authorName,
  authorUrl,
  authorBio,
  authorAvatar,
  category,
  isArticle = false,
  isAuthorProfile = false,
  itemListItems
} = Astro.props;

// URLs
const canonicalURL = new URL(
  Astro.url.pathname.replace(/\/$/, ''),
  Astro.site || Astro.url
);

const pageUrl = canonicalURL.toString();
const siteUrl = new URL('/', Astro.site || Astro.url).toString();
const pagePath = canonicalURL.pathname || '/';

// Site Data
const siteName = SITE_TITLE;
const siteDescription = SITE_DESCRIPTION;

// Schema IDs
const organizationId = `${siteUrl}#organization`;
const websiteId = `${siteUrl}#website`;
const webpageId = `${pageUrl}#webpage`;

// Author
const authorSlug = authorName
  ? authorName
      .toLowerCase()
      .trim()
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/^-|-$/g, '')
  : null;

const authorId = authorSlug
  ? `${siteUrl}authors/${authorSlug}#person`
  : null;

// Social Image
const socialImage = image || authorAvatar || '/og-image.png';

const socialImageUrl = new URL(
  socialImage,
  Astro.site || Astro.url
).toString();

// Fix 10: time-sensitive articles published within the last 48 hours (of the
// build) with a timely keyword qualify as NewsArticle for Google News/Discover.
const publishedMs = articleDate ? Date.parse(articleDate) : NaN;
const isFreshNews =
  isArticle &&
  !Number.isNaN(publishedMs) &&
  Date.now() - publishedMs < 48 * 60 * 60 * 1000 &&
  /\b(launched|launch|record|2026|market|new)\b/i.test(title);

const articleType = isFreshNews ? 'NewsArticle' : 'BlogPosting';

// Page Type
const pageType =
  pagePath === '/contact-us'
    ? 'ContactPage'
    : pagePath === '/about'
    ? 'AboutPage'
    : pagePath.startsWith('/authors/')
    ? 'ProfilePage'
    : pagePath.startsWith('/category/')
    ? 'CollectionPage'
    : 'WebPage';

// Breadcrumbs
const pathSegments = pagePath.split('/').filter(Boolean);

const breadcrumbItems = [
  {
    '@type': 'ListItem',
    position: 1,
    name: 'Home',
    item: siteUrl
  },

  ...pathSegments.map((segment, index) => {
    const itemPath = `/${pathSegments
      .slice(0, index + 1)
      .join('/')}`;

    const isCategoryArchive =
      pathSegments[0] === 'category' && index === 1;

    const isArticleCategory =
      isArticle && index === 0;

    const labelSource =
      isCategoryArchive || isArticleCategory
        ? category
        : segment.replace(/-/g, ' ');

    return {
      '@type': 'ListItem',
      position: index + 2,
      name: (labelSource || segment).replace(
        /\b\w/g,
        (char) => char.toUpperCase()
      ),
      item: new URL(
        itemPath,
        Astro.site || Astro.url
      ).toString()
    };
  })
];

// Types
type JsonLdValue =
  | string
  | number
  | boolean
  | null
  | undefined
  | JsonLdValue[]
  | { [key: string]: JsonLdValue };

type JsonLdNode = {
  [key: string]: JsonLdValue;
};

// Schema Graph
const schemaGraph: JsonLdNode[] = [
  // Organization
  {
    '@type': 'Organization',
    '@id': organizationId,

    name: siteName,
    url: siteUrl,
    description: siteDescription,

    logo: {
      '@type': 'ImageObject',
      url: new URL(
        '/favicon-96x96.png',
        Astro.site || Astro.url
      ).toString()
    },

    email: 'contact@globalsblog.com',

    contactPoint: {
      '@type': 'ContactPoint',
      contactType: 'customer support',
      email: 'contact@globalsblog.com',
      availableLanguage: ['en'],
      url: new URL(
        '/contact-us',
        Astro.site || Astro.url
      ).toString()
    },

    sameAs: [
      'https://x.com/globalsblog_com',
      'https://www.instagram.com/globals_blog',
      'https://www.linkedin.com/company/globals-blog',
      'https://www.facebook.com/people/Globals-Blog/61590625202053',
      'https://www.pinterest.com/globals_blog',
      'https://youtube.com/@globalsblog',
      'https://medium.com/@globalsblog'
    ]
  },

  // Website
  {
    '@type': 'WebSite',
    '@id': websiteId,

    url: siteUrl,
    name: siteName,
    description: siteDescription,

    publisher: {
      '@id': organizationId
    },

    inLanguage: 'en'
  },

  // WebPage
  {
    '@type': pageType,
    '@id': webpageId,

    url: pageUrl,
    name: title,
    description: description,

    isPartOf: {
      '@id': websiteId
    },

    about: category
      ? {
          '@type': 'Thing',
          name: category
        }
      : undefined,

    mainEntity: isAuthorProfile && authorId
      ? {
          '@id': authorId
        }
      : undefined,

    primaryImageOfPage: {
      '@type': 'ImageObject',
      url: socialImageUrl
    },

    breadcrumb: {
      '@id': `${pageUrl}#breadcrumb`
    },

    inLanguage: 'en'
  },

  // Breadcrumb
  {
    '@type': 'BreadcrumbList',
    '@id': `${pageUrl}#breadcrumb`,

    itemListElement: breadcrumbItems
  }
];

// Fix 8: LocalBusiness schema on the homepage only — gives Google/AI engines
// a physical-entity signal (address, contact) for local trust and GEO answers.
if (pagePath === '/') {
  schemaGraph.push({
    '@type': 'LocalBusiness',
    '@id': `${siteUrl}#localbusiness`,

    name: siteName,
    url: siteUrl,
    email: 'contact@globalsblog.com',

    image: new URL('/og-image.png', Astro.site || Astro.url).toString(),

    address: {
      '@type': 'PostalAddress',
      streetAddress: 'The Edge Tower, Ramprastha City, Sector 37D',
      addressLocality: 'Gurugram',
      addressRegion: 'Haryana',
      postalCode: '122006',
      addressCountry: 'IN'
    },

    parentOrganization: {
      '@id': organizationId
    },

    sameAs: [
      'https://x.com/globalsblog_com',
      'https://www.instagram.com/globals_blog',
      'https://www.linkedin.com/company/globals-blog',
      'https://www.facebook.com/people/Globals-Blog/61590625202053',
      'https://www.pinterest.com/globals_blog',
      'https://youtube.com/@globalsblog',
      'https://medium.com/@globalsblog'
    ]
  });
}

// Author
if ((isArticle || isAuthorProfile) && authorName && authorId) {
  schemaGraph.push({
    '@type': 'Person',
    '@id': authorId,

    name: authorName,
    description: authorBio || undefined,
    image: authorAvatar
      ? {
          '@type': 'ImageObject',
          url: new URL(authorAvatar, Astro.site || Astro.url).toString()
        }
      : undefined,

    url: new URL(`/authors/${authorSlug}`, Astro.site || Astro.url).toString(),

    worksFor: {
      '@id': organizationId
    },

    sameAs: authorUrl
      ? [authorUrl]
      : undefined
  });
}

// BlogPosting / NewsArticle (Fix 10: NewsArticle for fresh timely content)
if (isArticle) {
  schemaGraph.push({
    '@type': articleType,
    '@id': `${pageUrl}#article`,

    mainEntityOfPage: {
      '@id': webpageId
    },

    headline: title,
    description: description,

    image: [
      {
        '@type': 'ImageObject',
        url: socialImageUrl,
        width: 1200,
        height: 675
      }
    ],

    datePublished: articleDate,
    dateModified: articleModified || articleDate,

    articleSection: category,

    keywords: category ? [category, 'India', 'GlobalsBlog'] : undefined,

    // Fix 7: point Speakable at the rendered article content and FAQ blocks
    // (.faq-wrap is the FAQ class used inside post content) for voice assistants.
    speakable: {
      '@type': 'SpeakableSpecification',
      cssSelector: ['.article-body', '.faq-wrap']
    },

    // NOTE: aggregateRating was removed — Google rejects it on BlogPosting
    // (only Product/Recipe/Course/etc. may carry ratings) and it caused an
    // "invalid item" error in the Rich Results Test.

    // Fix 10: NewsArticle-only properties
    dateline: isFreshNews ? 'Gurugram, Haryana, India' : undefined,
    thumbnailUrl: isFreshNews ? socialImageUrl : undefined,

    inLanguage: 'en',

    isAccessibleForFree: true,

    isPartOf: {
      '@id': websiteId
    },

    author: authorName
      ? {
          '@id': authorId || undefined,
          '@type': 'Person',
          name: authorName,
          url: authorSlug
            ? new URL(`/authors/${authorSlug}`, Astro.site || Astro.url).toString()
            : authorUrl || undefined
        }
      : undefined,

    publisher: {
      '@id': organizationId
    }
  });
}

// ItemList (e.g. homepage/category "latest articles" cards)
if (itemListItems && itemListItems.length > 0) {
  schemaGraph.push({
    '@type': 'ItemList',
    name: title,
    itemListElement: itemListItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      url: new URL(item.url, Astro.site || Astro.url).toString(),
      name: item.name || undefined
    }))
  });
}

// Final Schema
const schema = {
  '@context': 'https://schema.org',
  '@graph': schemaGraph
};
---

<!-- Charset -->
<meta charset="utf-8" />

<!-- Viewport -->
<meta
  name="viewport"
  content="width=device-width,initial-scale=1"
/>

<!-- Favicons -->
<link
  rel="icon"
  type="image/png"
  href="/favicon-96x96.png"
  sizes="96x96"
/>

<link
  rel="icon"
  type="image/svg+xml"
  href="/favicon.svg"
/>

<link
  rel="shortcut icon"
  href="/favicon.ico"
/>

<link
  rel="apple-touch-icon"
  sizes="180x180"
  href="/apple-touch-icon.png"
/>

<link
  rel="manifest"
  href="/site.webmanifest"
/>

<!-- RSS -->
<link
  rel="alternate"
  type="application/rss+xml"
  title={SITE_TITLE}
  href={new URL('rss.xml', Astro.site)}
/>

<!-- LLMs.txt — AI/LLM content discovery -->
<link
  rel="alternate"
  type="text/plain"
  title="LLMs.txt"
  href={new URL('llms.txt', Astro.site)}
/>

<!-- Generator -->
<meta
  name="generator"
  content={Astro.generator}
/>

<!-- Canonical -->
<link
  rel="canonical"
  href={canonicalURL}
/>

<!-- Sitemap -->
<link
  rel="sitemap"
  type="application/xml"
  href="/sitemap-index.xml"
/>

<!-- Primary SEO -->
<title>{title}</title>

<meta
  name="description"
  content={description}
/>

{keywords && (
  <meta name="keywords" content={keywords} />
)}

<meta
  name="author"
  content={authorName || SITE_TITLE}
/>

<!-- Open Graph -->
<meta
  property="og:type"
  content={isArticle ? 'article' : 'website'}
/>

<meta
  property="og:site_name"
  content={SITE_TITLE}
/>

<meta
  property="og:url"
  content={pageUrl}
/>

<meta
  property="og:title"
  content={title}
/>

<meta
  property="og:description"
  content={description}
/>

<meta
  property="og:image"
  content={socialImageUrl}
/>

<meta
  property="og:image:alt"
  content={title}
/>

<meta
  property="og:image:width"
  content="1200"
/>

<meta
  property="og:image:height"
  content="630"
/>

<meta
  property="og:locale"
  content="en_US"
/>

{isArticle && articleDate && (
  <meta property="article:published_time" content={articleDate} />
)}

{isArticle && (articleModified || articleDate) && (
  <meta property="article:modified_time" content={articleModified || articleDate} />
)}

{isArticle && category && (
  <meta property="article:section" content={category} />
)}

{isArticle && authorUrl && (
  <meta property="article:author" content={authorUrl} />
)}

<!-- Twitter -->
<meta
  name="twitter:card"
  content="summary_large_image"
/>

<meta
  name="twitter:site"
  content="@globalsblog_com"
/>

<meta
  name="twitter:url"
  content={pageUrl}
/>

<meta
  name="twitter:title"
  content={title}
/>

<meta
  name="twitter:description"
  content={description}
/>

<meta
  name="twitter:image"
  content={socialImageUrl}
/>

<!-- JSON-LD Schema -->
<script
  type="application/ld+json"
  is:inline
  set:html={JSON.stringify(schema)}
/>

<!-- Google Analytics -->
<script
  is:inline
  async
  src="https://www.googletagmanager.com/gtag/js?id=G-4Y99EX9SML"
></script>

<script is:inline>
  window.dataLayer = window.dataLayer || [];

  function gtag() {
    dataLayer.push(arguments);
  }

  gtag('js', new Date());

  gtag('config', 'G-4Y99EX9SML');
</script>
