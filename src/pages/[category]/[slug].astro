---
// src/pages/[category]/[slug].astro
import Layout from '../../layouts/Layout.astro';
import { createClient } from '@supabase/supabase-js';
import { Image } from 'astro:assets';
import '../../styles/blog-content.css';   // ← add this import

const supabase = createClient(
  import.meta.env.SUPABASE_URL,
  import.meta.env.SUPABASE_ANON_KEY
);

function slugify(value = '') {
  return value
    .toLowerCase()
    .trim()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');
}

export async function getStaticPaths() {
  const supabase = createClient(
    import.meta.env.SUPABASE_URL,
    import.meta.env.SUPABASE_ANON_KEY
  );

  const { data: posts } = await supabase
    .from('posts')
    .select('slug, accent_color, categories(name)')
    .eq('is_published', true);

  return posts?.map((post) => {
    const categoryData = Array.isArray(post.categories)
      ? post.categories[0]
      : post.categories;
    const categoryParam =
      categoryData?.name?.toLowerCase().replace(/\s+/g, '-') || 'blog';

    return {
      params: { category: categoryParam, slug: post.slug },
      props: { post },
    };
  }) || [];
}

const { slug } = Astro.params;

const { data: post } = await supabase
  .from('posts')
  .select(`
    *,
    author:author_id (
      name,
      bio,
      avatar_url,
      twitter_handle,
      handle_link
    ),
    categories(name)
  `)
  .eq('slug', slug)
  .single();

if (!post) return Astro.redirect('/404');

const categoryName = post.categories?.name || 'Lifestyle';

// accent_color column in Supabase — e.g. "red" | "blue" | "green" | "amber" | "teal" | "violet" | "orange" | "cyan"
// Falls back to "blue" if not set
const accentColor = post.accent_color || 'blue';
const authorProfileUrl = post.author?.name
  ? `/authors/${slugify(post.author.name)}`
  : null;
const clientSupabaseUrl = import.meta.env.SUPABASE_URL;
const clientSupabaseAnonKey = import.meta.env.SUPABASE_ANON_KEY;
---

<Layout
  title={`${post.title} | GlobalsBlog`}
  description={post.description ?? `Read ${post.title} on GlobalsBlog.`}
  image={post.hero_image}
  articleDate={post.published_at}
  authorName={post.author?.name}
  authorUrl={post.author?.handle_link}
  category={categoryName}
  isArticle={true}
>
  <article class="article-shell">
    <nav class="article-back">
      <a href="/">← Back to home</a>
    </nav>

    <header class="article-header">
      <span class="article-tag">{post.categories?.name ?? 'Story'}</span>
      <h1>{post.title}</h1>
      <p class="article-meta">
        {post.published_at && new Date(post.published_at).toLocaleDateString('en-US', {
          year: 'numeric', month: 'long', day: 'numeric',
        })}
      </p>
    </header>

    {post.hero_image && (
      <Image
        src={post.hero_image}
        width={1200}
        height={675}
        widths={[400, 1200]}
        sizes="(max-width: 800px) 100vw, 1200px"
        alt={post.title}
        loading="eager"
        fetchpriority="high"
        class="article-image w-full rounded-3xl shadow-2xl mb-12"
      />
    )}

    <!--
      data-accent drives the CSS variable --acc in blog-content.css
      Value comes from the accent_color column in Supabase posts table
    -->
    <section
      class="article-body"
      data-accent={accentColor}
    >
      <Fragment set:html={post.content} />
    </section>

    <section class="comment-card" aria-labelledby="comment-title">
      <div class="comment-heading">
        <div>
          <span class="label">Join the discussion</span>
          <h2 id="comment-title">Leave a comment</h2>
          <p>Share a quick thought about this story.</p>
        </div>
        <span class="comment-status">Review required</span>
      </div>

      <form
        class="comment-form"
        id="comment-form"
        data-post-id={post.id}
        data-post-slug={post.slug}
        data-supabase-url={clientSupabaseUrl}
        data-supabase-anon-key={clientSupabaseAnonKey}
      >
        <div class="comment-field-row">
          <label>
            <span>Name</span>
            <input type="text" name="name" autocomplete="name" placeholder="Your name" required />
          </label>
          <label>
            <span>Email</span>
            <input type="email" name="email" autocomplete="email" placeholder="you@example.com" />
          </label>
        </div>
        <label>
          <span>Comment</span>
          <textarea name="comment" rows="5" placeholder="Write your comment here..." required></textarea>
        </label>
        <div class="comment-actions">
          <p>Your comment is saved for review before publishing.</p>
          <button type="submit">Post comment</button>
        </div>
      </form>

      <div class="comment-submitted" id="comment-submitted" hidden>
        <div class="submitted-mark" aria-hidden="true">✓</div>
        <div>
          <strong>Comment submitted</strong>
          <p>Thanks for sharing your view. It is ready for review.</p>
        </div>
      </div>

      <div class="comment-error" id="comment-error" hidden>
        <strong>Comment was not saved</strong>
        <p>Please try again in a moment.</p>
      </div>
    </section>

    {post.author && (
      <footer class="author-card">
        <div class="author-content">
          {authorProfileUrl ? (
            <a href={authorProfileUrl} aria-label={`View ${post.author.name} author profile`}>
              <img
                src={post.author.avatar_url}
                alt={post.author.name}
                class="author-avatar"
              />
            </a>
          ) : (
            <img
              src={post.author.avatar_url}
              alt={post.author.name}
              class="author-avatar"
            />
          )}
          <div class="author-text">
            <span class="label">Written by</span>
            <h3>
              {authorProfileUrl ? (
                <a href={authorProfileUrl}>{post.author.name}</a>
              ) : (
                post.author.name
              )}
            </h3>
            <p>{post.author.bio}</p>
            {authorProfileUrl && (
              <a href={authorProfileUrl} class="author-link">View author profile</a>
            )}
            {post.author.handle_link && (
              <a
                href={`${post.author.handle_link}`}
                class="author-link external-author-link"
                target="_blank"
                rel="noopener noreferrer"
              >
                Follow on {post.author.twitter_handle || 'Social'}
              </a>
            )}
          </div>
        </div>
      </footer>
    )}
  </article>
</Layout>

<!-- Keep your existing article-shell styles unchanged below -->
<style>
  .article-shell { width: min(860px, 100%); }
  .article-back { margin-bottom: 1rem; }
  .article-back a { text-decoration: none; color: var(--muted); font-weight: 500; transition: color 0.2s; }
  .article-back a:hover { color: var(--accent-strong); }
  .article-header {
    margin-bottom: 1rem;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border: 1px solid var(--line);
    border-radius: var(--radius-xl);
    background: var(--card);
    box-shadow: var(--shadow-tight);
  }
  .article-tag {
    display: inline-block;
    margin-bottom: 0.9rem;
    font-size: 0.78rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent-strong);
    font-weight: 700;
  }
  .article-header h1 { font-size: clamp(2rem, 5vw, 3.5rem); line-height: 1; margin: 0; }
  .article-meta { margin: 1.5rem 0 0; color: var(--muted); font-size: 0.9rem; }
  .article-image {
    width: 100%;
    aspect-ratio: 16/9;
    object-fit: cover;
    border-radius: var(--radius-xl);
    margin-bottom: 3rem;
  }
  .article-body {
    border: 1px solid var(--line);
    border-radius: var(--radius-xl);
    background: rgba(255, 253, 248, 0.94);
    box-shadow: var(--shadow-tight);
    line-height: 1.7;
    font-size: 1.15rem;
    padding: clamp(1.5rem, 5vw, 3rem);   /* ← add padding here instead of in content */
  }
  .comment-card {
    margin-top: 3rem;
    padding: clamp(1.2rem, 4vw, 2rem);
    border: 1px solid var(--line);
    border-radius: var(--radius-xl);
    background:
      linear-gradient(135deg, rgba(255, 253, 248, 0.98), rgba(248, 243, 236, 0.9)),
      var(--card);
    box-shadow: var(--shadow-tight);
  }
  .comment-heading {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1.2rem;
    border-bottom: 1px solid var(--line);
  }
  .comment-heading h2 { margin: 0; font-size: clamp(1.45rem, 3vw, 2.1rem); }
  .comment-heading p { margin: 0.45rem 0 0; color: var(--muted); }
  .comment-status {
    flex: 0 0 auto;
    border: 1px solid rgba(182, 91, 46, 0.2);
    border-radius: 999px;
    background: rgba(182, 91, 46, 0.08);
    color: var(--accent-strong);
    padding: 0.35rem 0.65rem;
    font-size: 0.78rem;
    font-weight: 700;
  }
  .comment-form {
    display: grid;
    gap: 1.1rem;
    margin-top: 1.25rem;
  }
  .comment-field-row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }
  .comment-form label {
    display: grid;
    gap: 0.45rem;
    color: var(--ink-strong);
    font-weight: 700;
  }
  .comment-form label span { font-size: 0.92rem; }
  .comment-form input,
  .comment-form textarea {
    width: 100%;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: rgba(255, 253, 248, 0.92);
    color: var(--ink);
    padding: 0.85rem 0.95rem;
    outline: none;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.65);
    transition: border-color 180ms ease, box-shadow 180ms ease, background-color 180ms ease;
  }
  .comment-form input::placeholder,
  .comment-form textarea::placeholder {
    color: rgba(107, 98, 91, 0.72);
  }
  .comment-form input:focus,
  .comment-form textarea:focus {
    border-color: rgba(182, 91, 46, 0.58);
    background: #fffdf8;
    box-shadow: 0 0 0 4px rgba(182, 91, 46, 0.12);
  }
  .comment-form textarea { min-height: 150px; resize: vertical; }
  .comment-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .comment-actions p {
    margin: 0;
    color: var(--muted);
    font-size: 0.92rem;
  }
  .comment-form button {
    flex: 0 0 auto;
    min-height: 44px;
    border: 0;
    border-radius: 999px;
    background: linear-gradient(135deg, var(--ink-strong), #4a2b1d);
    color: #fff7ef;
    padding: 0.78rem 1.25rem;
    font-weight: 700;
    cursor: pointer;
    box-shadow: 0 10px 24px rgba(47, 33, 20, 0.13);
    transition: transform 180ms ease, box-shadow 180ms ease;
  }
  .comment-form button:hover {
    transform: translateY(-1px);
    box-shadow: 0 14px 30px rgba(47, 33, 20, 0.18);
  }
  .comment-form button:disabled {
    cursor: wait;
    opacity: 0.72;
    transform: none;
  }
  .comment-submitted {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin-top: 1.2rem;
    padding: 1rem 1.1rem;
    border: 1px solid rgba(64, 116, 63, 0.25);
    border-radius: 16px;
    background: linear-gradient(135deg, rgba(64, 116, 63, 0.11), rgba(255, 253, 248, 0.92));
  }
  .comment-form[hidden],
  .comment-submitted[hidden],
  .comment-error[hidden] {
    display: none;
  }
  .submitted-mark {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: #40743f;
    color: #fffdf8;
    font-weight: 700;
  }
  .comment-submitted strong { color: var(--ink-strong); }
  .comment-submitted p { margin: 0.25rem 0 0; color: var(--muted); }
  .comment-error {
    margin-top: 1.2rem;
    padding: 1rem 1.1rem;
    border: 1px solid rgba(150, 56, 45, 0.25);
    border-radius: 16px;
    background: rgba(150, 56, 45, 0.08);
  }
  .comment-error strong { color: var(--ink-strong); }
  .comment-error p { margin: 0.25rem 0 0; color: var(--muted); }
  .author-card {
    margin-top: 4rem;
    padding: 2.5rem;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius-xl);
    position: relative;
    overflow: hidden;
  }
  .author-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0;
    width: 4px; height: 100%;
    background: var(--accent-strong);
  }
  .author-content { display: flex; gap: 2rem; align-items: center; }
  .author-content > a { flex: 0 0 auto; }
  .author-avatar {
    width: 100px; height: 100px;
    border-radius: 20%;
    object-fit: cover;
    border: 4px solid var(--background);
    box-shadow: var(--shadow);
  }
  .label { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.1rem; color: var(--muted); display: block; margin-bottom: 0.25rem; }
  .author-text h3 { margin: 0; font-size: 1.5rem; color: var(--heading); }
  .author-text h3 a { color: inherit; text-decoration: none; }
  .author-text h3 a:hover { color: var(--accent-strong); }
  .author-text p  { margin: 0.5rem 0 1rem; color: var(--text); font-size: 1rem; opacity: 0.85; }
  .author-link { display: inline-flex; margin-right: 0.9rem; font-size: 0.85rem; font-weight: 700; color: var(--accent-strong); text-decoration: none; border-bottom: 2px solid transparent; transition: border 0.2s; }
  .author-link:hover { border-color: var(--accent-strong); }
	  @media (max-width: 600px) {
    .comment-heading,
    .comment-actions {
      align-items: stretch;
      flex-direction: column;
    }
    .comment-field-row {
      grid-template-columns: 1fr;
    }
    .comment-form button {
      width: 100%;
    }
	    .author-content { flex-direction: column; text-align: center; }
	    .author-card { padding: 2rem 1.5rem; }
	  }
	</style>

<script>
  import { createClient } from '@supabase/supabase-js';

  const commentForm = document.getElementById('comment-form') as HTMLFormElement | null;
  const submittedMessage = document.getElementById('comment-submitted');
  const errorMessage = document.getElementById('comment-error');
  const submitButton = commentForm?.querySelector('button[type="submit"]') as HTMLButtonElement | null;

  commentForm?.addEventListener('submit', async (event) => {
    event.preventDefault();

    const supabaseUrl = commentForm.dataset.supabaseUrl;
    const supabaseAnonKey = commentForm.dataset.supabaseAnonKey;
    const formData = new FormData(commentForm);
    const name = String(formData.get('name') || '').trim();
    const email = String(formData.get('email') || '').trim();
    const comment = String(formData.get('comment') || '').trim();
    const postId = Number(commentForm.dataset.postId);

    if (!supabaseUrl || !supabaseAnonKey || !name || !comment) {
      errorMessage?.removeAttribute('hidden');
      return;
    }

    errorMessage?.setAttribute('hidden', '');
    submitButton?.setAttribute('disabled', '');
    if (submitButton) submitButton.textContent = 'Posting...';

    const supabase = createClient(supabaseUrl, supabaseAnonKey);
    const { error } = await supabase.from('comments').insert({
      post_id: Number.isNaN(postId) ? null : postId,
      post_slug: commentForm.dataset.postSlug,
      name,
      email: email || null,
      comment,
      is_approved: false,
    });

    submitButton?.removeAttribute('disabled');
    if (submitButton) submitButton.textContent = 'Post comment';

    if (error) {
      errorMessage?.removeAttribute('hidden');
      return;
    }

    commentForm.reset();
    commentForm.setAttribute('hidden', '');
    submittedMessage?.removeAttribute('hidden');
  });
</script>
