---
import Layout from '../../layouts/Layout.astro';
import { createClient } from '@supabase/supabase-js';
import { Image } from 'astro:assets';

const supabase = createClient(
  import.meta.env.SUPABASE_URL,
  import.meta.env.SUPABASE_ANON_KEY
);

export async function getStaticPaths() {
  const supabase = createClient(
    import.meta.env.SUPABASE_URL,
    import.meta.env.SUPABASE_ANON_KEY
  );
  
  const { data: posts } = await supabase
    .from('posts')
    .select('slug, categories(name)')
    .eq('is_published', true);
  
  return posts?.map((post) => {
    // FIX: Access the first element of the categories array
    // Supabase returns nested joins as arrays unless specified otherwise
    const categoryData = Array.isArray(post.categories) ? post.categories[0] : post.categories;
    const categoryParam = categoryData?.name?.toLowerCase().replace(/\s+/g, '-') || 'blog';
    
    return {
      params: { 
        category: categoryParam, 
        slug: post.slug 
      },
      props: { post },
    };
  }) || [];
}

const { slug } = Astro.params;

// Fetch full post data with author and category details
const { data: post } = await supabase
  .from('posts')
  .select(`
    *,
    author:author_id (
      name,
      bio,
      avatar_url,
      twitter_handle,
      handle_link
    ),
    categories(name)
  `)
  .eq('slug', slug)
  .single();

if (!post) return Astro.redirect('/404');

const categoryName = post.categories?.name || 'Lifestyle';


---

<Layout
  title={`${post.title} | GlobalsBlog`}
  description={post.excerpt ?? `Read ${post.title} on GlobalsBlog.`}
  image={post.hero_image}
  articleDate={post.published_at}
  authorName={post.author?.name}
  authorUrl={post.author?.handle_link}
  category={categoryName}
  isArticle={true}
>
  <article class="article-shell">
    <nav class="article-back">
      <a href="/">← Back to home</a>
    </nav>

    <header class="article-header">
      <span class="article-tag">{post.categories?.name ?? 'Story'}</span>
      <h1>{post.title}</h1>
      <p class="article-meta">
        {post.published_at && new Date(post.published_at).toLocaleDateString('en-US', {
          year: 'numeric',
          month: 'long',
          day: 'numeric',
        })}
      </p>
    </header>

    {post.hero_image && (
      <Image 
        src={post.hero_image} 
        width={1200} 
        height={675} 
        widths={[400, 800, 1200]}
        sizes="(max-width: 800px) 100vw, 1200px"
        alt={post.title}
        loading="eager" 
        fetchpriority="high"
        class="article-image w-full rounded-3xl shadow-2xl mb-12"
      />
    )}

    <section class="article-body">
      <Fragment set:html={post.content} />
    </section>

    {post.author && (
      <footer class="author-card">
        <div class="author-content">
          <img src={post.author.avatar_url} alt={post.author.name} class="author-avatar" />
          <div class="author-text">
            <span class="label">Written by</span>
            <h3>{post.author.name}</h3>
            <p>{post.author.bio}</p>
            {post.author.handle_link && (
              <a href={`${post.author.handle_link}`} class="author-link" target="_blank">
                Follow on {post.author.twitter_handle || 'Social'}
              </a>
            )}
          </div>
        </div>
      </footer>
    )}
  </article>
</Layout>

<style>
  .article-shell {
    width: min(860px, 100%);
    margin: 2rem auto 5rem;
    padding: 0 1rem;
  }

  .article-back {
    margin-bottom: 1.5rem;
  }

  .article-back a {
    text-decoration: none;
    color: var(--muted);
    font-weight: 500;
    transition: color 0.2s;
  }

  .article-back a:hover {
    color: var(--accent-strong);
  }

  .article-header {
    margin-bottom: 2rem;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border: 1px solid var(--line);
    border-radius: var(--radius-xl);
    background: var(--card);
    box-shadow: var(--shadow-tight);
  }

  .article-tag {
    display: inline-block;
    margin-bottom: 0.9rem;
    font-size: 0.78rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent-strong);
    font-weight: 700;
  }

  .article-header h1 {
    font-size: clamp(2rem, 5vw, 3.5rem);
    line-height: 1.1;
    margin: 0;
  }

  .article-meta {
    margin: 1.5rem 0 0;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .article-image {
    width: 100%;
    aspect-ratio: 16/9;
    object-fit: cover;
    border-radius: var(--radius-xl);
    margin-bottom: 3rem;
  }

  .article-body {
    padding: clamp(1.5rem, 5vw, 3rem);
    border: 1px solid var(--line);
    border-radius: var(--radius-xl);
    background: rgba(255, 253, 248, 0.94);
    box-shadow: var(--shadow-tight);
    line-height: 1.7;
    font-size: 1.15rem;
  }

  .author-card {
    margin-top: 4rem;
    padding: 2.5rem;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius-xl);
    position: relative;
    overflow: hidden;
  }

  .author-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 4px;
    height: 100%;
    background: var(--accent-strong);
  }

  .author-content {
    display: flex;
    gap: 2rem;
    align-items: center;
  }

  .author-avatar {
    width: 100px;
    height: 100px;
    border-radius: 50%;
    object-fit: cover;
    border: 4px solid var(--background);
    box-shadow: var(--shadow);
  }

  .label {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1rem;
    color: var(--muted);
    display: block;
    margin-bottom: 0.25rem;
  }

  .author-text h3 {
    margin: 0;
    font-size: 1.5rem;
    color: var(--heading);
  }

  .author-text p {
    margin: 0.5rem 0 1rem;
    color: var(--text);
    font-size: 1rem;
    opacity: 0.85;
  }

  .author-link {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--accent-strong);
    text-decoration: none;
    border-bottom: 2px solid transparent;
    transition: border 0.2s;
  }

  .author-link:hover {
    border-color: var(--accent-strong);
  }

  @media (max-width: 600px) {
    .author-content {
      flex-direction: column;
      text-align: center;
    }
    .author-card {
      padding: 2rem 1.5rem;
    }
  }

  .article-body :global(h2) { font-size: 2rem; margin-top: 3rem; }
  .article-body :global(p) { margin-bottom: 1.5rem; }
  .article-body :global(img) { border-radius: var(--radius-lg); margin: 3rem 0; }
</style>