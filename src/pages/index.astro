---
import Layout from '../layouts/Layout.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import { getPosts } from '../lib/api.js';
import { SITE_CATEGORIES } from '../consts';

// Step 1 — featured post (most recent, any category)
const [featuredPost] = await getPosts({ limit: 1 });

// Step 2 — latest 3 per category, excluding the featured post
const fetchCategory = (slug: string) =>
  getPosts({ category: slug, excludeSlug: featuredPost?.slug ?? '', limit: 3 });

const [travelPosts, autoPosts, beautyPosts] = await Promise.all([
  fetchCategory('travel'),
  fetchCategory('auto'),
  fetchCategory('beauty'),
]);

// Category section metadata with keyword-rich headings
const categorySections = [
  {
    slug: 'travel',
    label: 'Travel',
    id: 'travel',
    heading: 'Travel Guides, Budget Travel Tips & Destination Itineraries',
    description:
      'From solo travel hacks and honeymoon packages to budget destination guides and adventure itineraries — all in one focused archive.',
    posts: travelPosts,
  },
  {
    slug: 'auto',
    label: 'Auto',
    id: 'auto',
    heading: 'Car Reviews, Best Mileage Cars & Auto Buying Guides',
    description:
      'Discover the best mileage cars, read expert buying guides, compare SUVs, get fuel efficiency tips, and follow the latest auto industry news.',
    posts: autoPosts,
  },
  {
    slug: 'beauty',
    label: 'Beauty',
    id: 'beauty',
    heading: 'Skincare Routines, Makeup Tutorials & Beauty Tips',
    description:
      'Easy makeup tutorials, skincare routines for every skin type, ingredient guides for niacinamide, retinol, and vitamin C, and the latest beauty trends.',
    posts: beautyPosts,
  },
];

interface Post {
  slug: string;
  title: string;
  description?: string;
  heroImage?: string;
  publishedAt?: string;
  category: { name: string; slug?: string } | null;
}

const getPostUrl = (post: Post) => {
  const catSlug = post.category?.slug || post.category?.name?.toLowerCase().replace(/\s+/g, '-') || 'blog';
  return `/${catSlug}/${post.slug}`;
};

const formatDate = (iso?: string) =>
  iso
    ? new Date(iso).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })
    : '';

// ItemList schema — every article card shown on the homepage
const itemListItems = [
  ...(featuredPost ? [{ url: getPostUrl(featuredPost), name: featuredPost.title }] : []),
  ...categorySections.flatMap((section) =>
    (section.posts as Post[]).map((post) => ({ url: getPostUrl(post), name: post.title }))
  ),
];
---

<Layout
  title="GlobalsBlog | Travel, Auto & Beauty Articles"
  description="GlobalsBlog — India's practical guide to travel destinations, honest car reviews, and skincare for Indian skin. Free calculators for trip costs, car loans, EV savings and more."
  keywords="travel blog India, auto news India, beauty tips India, visa free countries Indian passport, best places visit India 2026, best electric car India 2026, cheapest EV India, best sunscreen India, sunscreen oily skin India, fuel cost calculator India, car loan EMI calculator India, EV savings calculator India, toll calculator India, road trip planner India, trip cost calculator India, train vs flight India, travel budget planner India, India travel guide, Indian passport visa on arrival, monsoon travel India, budget travel India, solo travel India, SUV India 2026, best mileage car India, petrol vs electric car India, skincare routine Indian skin, kajal eyeliner guide India, niacinamide India, retinol India, eye makeup guide India, free online calculators India, travel calculators India, auto calculators India, FASTag toll charges, car buying guide India 2026"
  itemListItems={itemListItems}
>
  <!-- HERO -->
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">Travel · Auto · Beauty · Free Tools</p>
      <h1>Articles, guides &amp; free calculators for travel, auto, and beauty.</h1>
      <p class="hero-text">
        GlobalsBlog publishes practical articles and free interactive tools — fuel cost calculators,
        car loan EMI, trip budget planners, and more — all in one well-organised place.
      </p>
      <div class="hero-actions">
        <a class="button-primary" href="#travel">Browse articles</a>
        <a class="button-secondary" href="/tools">Free calculators</a>
      </div>
    </div>

    <div class="hero-panel">
      <p class="panel-label">Browse categories</p>
      <div class="category-pills">
        {SITE_CATEGORIES.map((item) => (
          <a href={`#${item.label.toLowerCase()}`} aria-label={`Jump to ${item.label} articles`}>
            {item.label}
          </a>
        ))}
        <a href="/tools" aria-label="Free online calculators">🧰 Tools</a>
      </div>
      <p class="panel-copy">
        Practical articles across three categories, plus free calculators built for Indian travellers and car owners.
      </p>
    </div>
  </section>

  <!-- FEATURED STORY -->
  {featuredPost && (
    <section class="featured-story" aria-label="Featured article">
      <a class="featured-card" href={getPostUrl(featuredPost)}>
        <div class="featured-content">
          <p class="eyebrow">Featured story</p>
          <span class="story-tag">
            {featuredPost.category?.name ?? 'Latest'}
          </span>
          <h2>{featuredPost.title}</h2>
          <p>{featuredPost.description || ''}</p>
          {featuredPost.publishedAt && (
            <time class="card-date" datetime={featuredPost.publishedAt}>
              {formatDate(featuredPost.publishedAt)}
            </time>
          )}
        </div>
        {featuredPost.heroImage && (
          <img
            src={featuredPost.heroImage}
            alt={featuredPost.title}
            width="800"
            height="450"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        )}
      </a>
    </section>
  )}

  <!-- CATEGORY SHOWCASE -->
  <section class="category-showcase" aria-labelledby="categories-heading">
    <div class="showcase-heading">
      <p class="eyebrow">What we cover</p>
      <h2 id="categories-heading">Browse by topic</h2>
    </div>
    <div class="showcase-grid">
      {SITE_CATEGORIES.map((cat) => (
        <a href={`/category/${cat.label.toLowerCase()}`} class="showcase-card">
          <strong>{cat.label}</strong>
          <p>{cat.description}</p>
          <span class="showcase-cta">Read {cat.label} articles →</span>
        </a>
      ))}
    </div>
  </section>

  <!-- FREE TOOLS SECTION -->
  <section class="tools-section" aria-labelledby="tools-heading">
    <div class="tools-section-header">
      <div>
        <p class="eyebrow">Free Online Tools</p>
        <h2 id="tools-heading">Travel &amp; Auto Calculators</h2>
        <p class="tools-section-desc">
          Eight free calculators built for Indian travellers and car owners — fuel cost,
          car loan EMI, EV savings, trip budget, road trip planner, toll charges, and more.
        </p>
      </div>
      <a href="/tools" class="view-all-link" aria-label="Browse all free calculators">
        Browse all tools →
      </a>
    </div>
    <div class="tools-grid">
      <a href="/tools/fuel-cost-calculator" class="tool-card">
        <span class="tool-icon">⛽</span>
        <strong>Fuel Cost Calculator</strong>
        <p>Calculate petrol or diesel expense for any road trip in seconds.</p>
        <span class="tool-cta">Calculate now →</span>
      </a>
      <a href="/tools/car-loan-calculator" class="tool-card">
        <span class="tool-icon">🏦</span>
        <strong>Car Loan EMI Calculator</strong>
        <p>Find your monthly EMI, total interest, and best loan tenure.</p>
        <span class="tool-cta">Calculate now →</span>
      </a>
      <a href="/tools/ev-savings-calculator" class="tool-card">
        <span class="tool-icon">⚡</span>
        <strong>EV Savings Calculator</strong>
        <p>See how much you save switching from petrol to electric vehicle.</p>
        <span class="tool-cta">Calculate now →</span>
      </a>
      <a href="/tools/toll-calculator" class="tool-card">
        <span class="tool-icon">🚧</span>
        <strong>Toll Calculator</strong>
        <p>Estimate highway toll charges with FASTag vs cash comparison.</p>
        <span class="tool-cta">Estimate now →</span>
      </a>
      <a href="/tools/trip-cost-calculator" class="tool-card">
        <span class="tool-icon">✈</span>
        <strong>Trip Cost Calculator</strong>
        <p>Estimate your total holiday cost — transport, hotel, food and more.</p>
        <span class="tool-cta">Plan now →</span>
      </a>
      <a href="/tools/travel-budget-planner" class="tool-card">
        <span class="tool-icon">📋</span>
        <strong>Travel Budget Planner</strong>
        <p>Build a category-by-category holiday budget with a per-person breakdown.</p>
        <span class="tool-cta">Plan now →</span>
      </a>
      <a href="/tools/road-trip-planner" class="tool-card">
        <span class="tool-icon">🗺</span>
        <strong>Road Trip Planner</strong>
        <p>Calculate the full cost of a self-drive trip with tolls and food.</p>
        <span class="tool-cta">Plan now →</span>
      </a>
      <a href="/tools/train-vs-flight-calculator" class="tool-card">
        <span class="tool-icon">🆚</span>
        <strong>Train vs Flight</strong>
        <p>Compare true cost and door-to-door travel time for any Indian route.</p>
        <span class="tool-cta">Compare now →</span>
      </a>
    </div>
  </section>

  <!-- PER-CATEGORY SECTIONS -->
  <!-- Fix 13: newsletter card renders after the first section (3rd article card) -->
  {categorySections.map((section, sectionIndex) => (
    <>
    <section class="cat-section" id={section.id} aria-labelledby={`${section.id}-heading`}>
      <div class="cat-section-header">
        <div class="cat-section-meta">
          <p class="eyebrow">Latest {section.label}</p>
          <h2 id={`${section.id}-heading`}>{section.heading}</h2>
          <p class="cat-section-desc">{section.description}</p>
        </div>
        <a href={`/category/${section.slug}`} class="view-all-link" aria-label={`View all ${section.label} articles`}>
          View all {section.label} →
        </a>
      </div>

      {section.posts.length > 0 ? (
        <div class="cat-grid">
          {section.posts.map((post) => (
              <article class="cat-card">
                <a href={getPostUrl(post)}>
                  {post.heroImage && (
                    <img
                      src={post.heroImage}
                      alt={post.title}
                      width="600"
                      height="338"
                      loading="lazy"
                      decoding="async"
                    />
                  )}
                  <div class="cat-card-body">
                    <span class="story-tag">{post.category?.name ?? section.label}</span>
                    <h3>{post.title}</h3>
                    <p>{post.description || ''}</p>
                    {post.publishedAt && (
                      <time class="card-date" datetime={post.publishedAt}>
                        {formatDate(post.publishedAt)}
                      </time>
                    )}
                  </div>
                </a>
              </article>
          ))}
        </div>
      ) : (
        <div class="cat-empty">
          <p>No {section.label.toLowerCase()} articles published yet. Check back soon.</p>
        </div>
      )}
    </section>
    {sectionIndex === 0 && <NewsletterSignup dismissible={false} />}
    </>
  ))}
</Layout>

<style>
  /* ── Hero ── */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(280px, 0.75fr);
    gap: 1.5rem;
    align-items: stretch;
    padding: 1rem 0 2rem;
  }

  .hero-copy,
  .hero-panel,
  .featured-card,
  .cat-card a {
    border: 1px solid var(--line);
    background: var(--card);
    box-shadow: var(--shadow-tight);
  }

  .hero-copy {
    padding: clamp(1.5rem, 4vw, 3rem);
    border-radius: var(--radius-xl);
  }

  .hero-text {
    max-width: 46rem;
    font-size: 1.08rem;
    color: var(--muted);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 1.5rem;
  }

  .button-primary,
  .button-secondary,
  .category-pills a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    border-radius: 999px;
  }

  .button-primary,
  .button-secondary {
    padding: 0.82rem 1.2rem;
  }

  .button-primary {
    background: var(--ink-strong);
    color: #fff7ef;
  }

  .button-primary:hover {
    color: #fff7ef;
    transform: translateY(-1px);
  }

  .button-secondary {
    border: 1px solid var(--line);
    color: var(--ink-strong);
    background: rgba(255, 255, 255, 0.55);
  }

  .hero-panel {
    border-radius: var(--radius-xl);
    padding: 1.5rem;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.82), rgba(239, 228, 213, 0.95));
  }

  .panel-label {
    margin-bottom: 1rem;
    font-size: 0.78rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .panel-copy {
    color: var(--muted);
    margin-top: 1rem;
  }

  .category-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .category-pills a {
    padding: 0.75rem 1rem;
    background: rgba(255, 255, 255, 0.78);
    color: var(--ink-strong);
    border: 1px solid rgba(68, 52, 39, 0.09);
  }

  /* ── Shared ── */
  .eyebrow {
    margin-bottom: 0.75rem;
    font-size: 0.78rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .story-tag {
    display: inline-block;
    margin-bottom: 0.7rem;
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent-strong);
    font-weight: 700;
  }

  .card-date {
    display: block;
    margin-top: 0.75rem;
    font-size: 0.8rem;
    color: var(--muted);
  }

  /* ── Featured ── */
  .featured-story {
    margin-top: 1.5rem;
  }

  .featured-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 0.95fr);
    gap: 1.4rem;
    padding: 1.25rem;
    border-radius: var(--radius-xl);
    text-decoration: none;
    transition: transform 180ms ease, box-shadow 180ms ease;
  }

  .featured-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow);
  }

  .featured-content {
    padding: 0.6rem;
  }

  .featured-content p:not(.eyebrow) {
    color: var(--muted);
  }

  .featured-card img {
    width: 100%;
    height: 100%;
    min-height: 320px;
    object-fit: cover;
    border-radius: calc(var(--radius-xl) - 10px);
  }

  .featured-content h2 {
    font-size: clamp(1.5rem, 3vw, 2.4rem);
  }

  /* ── Category showcase ── */
  .category-showcase {
    margin-top: 2rem;
  }

  .showcase-heading {
    margin-bottom: 1.2rem;
  }

  .showcase-heading h2 {
    margin-bottom: 0;
  }

  .showcase-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.1rem;
  }

  .showcase-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.3rem 1.2rem 1.1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--card);
    box-shadow: var(--shadow-tight);
    text-decoration: none;
    transition: transform 180ms ease, box-shadow 180ms ease;
  }

  .showcase-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow);
  }

  .showcase-card strong {
    font-size: 1.1rem;
    color: var(--ink-strong);
  }

  .showcase-card p {
    margin: 0;
    font-size: 0.9rem;
    color: var(--muted);
    line-height: 1.55;
    flex: 1;
  }

  .showcase-cta {
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--accent-strong);
    margin-top: 0.4rem;
  }

  /* ── Tools section ── */
  .tools-section {
    margin-top: 2.5rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--line);
  }

  .tools-section-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 1.4rem;
  }

  .tools-section-header h2 {
    font-size: clamp(1.35rem, 2.5vw, 1.9rem);
    margin-bottom: 0.4rem;
  }

  .tools-section-desc {
    margin: 0;
    max-width: 58rem;
    font-size: 0.96rem;
    color: var(--muted);
    line-height: 1.6;
  }

  .tools-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
  }

  .tool-card {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1.2rem 1.1rem 1rem;
    border: 1.5px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--card);
    box-shadow: var(--shadow-tight);
    text-decoration: none;
    color: var(--ink);
    transition: transform 180ms ease, box-shadow 180ms ease, border-color 180ms ease;
  }

  .tool-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow);
    border-color: var(--accent);
    color: var(--ink);
  }

  .tool-icon {
    font-size: 1.6rem;
    line-height: 1;
    margin-bottom: 0.2rem;
  }

  .tool-card strong {
    font-size: 0.97rem;
    color: var(--ink-strong);
    line-height: 1.3;
  }

  .tool-card p {
    margin: 0;
    font-size: 0.84rem;
    color: var(--muted);
    line-height: 1.5;
    flex: 1;
  }

  .tool-cta {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--accent);
    margin-top: 0.3rem;
  }

  /* ── Per-category sections ── */
  .cat-section {
    margin-top: 3rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--line);
  }

  .cat-section-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .cat-section-meta h2 {
    font-size: clamp(1.35rem, 2.5vw, 1.9rem);
    margin-bottom: 0.5rem;
  }

  .cat-section-desc {
    margin: 0;
    max-width: 58rem;
    font-size: 0.96rem;
    color: var(--muted);
    line-height: 1.6;
  }

  .view-all-link {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--accent-strong);
    text-decoration: none;
    border-bottom: 2px solid transparent;
    transition: border-color 180ms ease;
    padding-bottom: 1px;
  }

  .view-all-link:hover {
    border-color: var(--accent-strong);
  }

  .cat-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.2rem;
  }

  .cat-card a {
    display: block;
    height: 100%;
    border-radius: var(--radius-lg);
    overflow: hidden;
    text-decoration: none;
    transition: transform 180ms ease, box-shadow 180ms ease;
  }

  .cat-card a:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow);
  }

  .cat-card img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }

  .cat-card-body {
    padding: 1.1rem 1.2rem 1.3rem;
  }

  .cat-card-body h3 {
    margin: 0 0 0.5rem;
    font-size: 1.18rem;
    line-height: 1.3;
    color: var(--ink-strong);
  }

  .cat-card-body p {
    margin: 0;
    font-size: 0.9rem;
    color: var(--muted);
    line-height: 1.55;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .cat-empty {
    padding: 1.5rem;
    border: 1px dashed var(--line);
    border-radius: var(--radius-lg);
    color: var(--muted);
    font-size: 0.9rem;
  }

  /* ── Responsive ── */
  @media (max-width: 960px) {
    .hero,
    .featured-card {
      grid-template-columns: 1fr;
    }

    .showcase-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .tools-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .cat-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .cat-section-header,
    .tools-section-header {
      align-items: flex-start;
      flex-direction: column;
    }
  }

  @media (max-width: 560px) {
    .showcase-grid,
    .cat-grid,
    .tools-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
