---
import Layout from '../layouts/Layout.astro';
---

<Layout
	title="About GlobalBlogs"
	description="Learn what GlobalBlogs publishes and how the site is structured for better reading and discovery."
>
	<section class="about-wrap">
		<p class="eyebrow">About the publication</p>
		<h1>GlobalBlogs is built for cleaner reading and stronger category discovery.</h1>
		<p>
			The site focuses on travel, auto, beauty, and adjacent lifestyle coverage. The goal is
			simple: publish stories in a layout that feels editorial, easy to scan, and easier to
			share across search and social platforms.
		</p>
		<p>
			Instead of burying articles under noisy navigation, the experience now centers category
			pages, recent story cards, and a more structured reading flow for each article.
		</p>
	</section>
</Layout>

<style>
	.about-wrap {
		width: min(860px, 100%);
		padding: clamp(1.5rem, 4vw, 2.5rem);
		border: 1px solid var(--line);
		border-radius: var(--radius-xl);
		background: var(--card);
		box-shadow: var(--shadow-tight);
	}

	.eyebrow,
	.about-wrap p {
		color: var(--muted);
	}

	.eyebrow {
		font-size: 0.78rem;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--accent);
	}
</style>
