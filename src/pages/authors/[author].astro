---
import Layout from '../../layouts/Layout.astro';
import { getAuthorsWithPosts, getPosts } from '../../lib/api.js';

type Category = { slug?: string; name?: string };

type Author = {
  id?: string;
  name?: string;
  bio?: string;
  avatarUrl?: string;
  twitterHandle?: string;
  handleLink?: string;
  jobTitle?: string;
  expertise?: string;   // comma-separated e.g. "Travel, Budget Travel, Solo Travel"
  location?: string;
};

type AuthorPost = {
  slug: string;
  title: string;
  description?: string;
  heroImage?: string;
  publishedAt?: string;
  category?: Category | null;
};

function slugify(value = '') {
  return value.toLowerCase().trim().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
}

function getPostUrl(post: AuthorPost) {
  const catSlug = post.category?.slug || slugify(post.category?.name || 'blog');
  return `/${catSlug}/${post.slug}`;
}

const formatDate = (iso?: string) =>
  iso
    ? new Date(iso).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })
    : '';

export async function getStaticPaths() {
  // getStaticPaths is compiled into an isolated scope by Astro, so it can't
  // see the module-level slugify() below — redefine it locally here.
  const slugify = (value = '') =>
    value.toLowerCase().trim().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');

  const authors = await getAuthorsWithPosts();
  return authors.map((author: Author) => ({
    params: { author: slugify(author.name || '') },
    props: { author },
  }));
}

interface Props {
  author: Author;
}

const authorSlug = Astro.params.author;
const { author } = Astro.props as Props;

if (!author) return Astro.redirect('/404');

const posts: AuthorPost[] = await getPosts({ authorId: author.id });

// ── Derived E-E-A-T data ────────────────────────────────────────────

// Category breakdown for topical authority signal
const categoryCounts: Record<string, number> = {};
posts?.forEach((post) => {
  const cat = post.category;
  if (cat?.name) categoryCounts[cat.name] = (categoryCounts[cat.name] || 0) + 1;
});
const sortedCategories = Object.entries(categoryCounts).sort((a, b) => b[1] - a[1]);
const topCategory = sortedCategories[0]?.[0] ?? null;
const expertiseAreas = sortedCategories.map(([name]) => name);

// Expertise tags: use the DB column if filled, else derive from posts
const expertiseTags: string[] = author.expertise
  ? author.expertise.split(',').map((s: string) => s.trim()).filter(Boolean)
  : expertiseAreas;

// Per-category expertise content — specific bullets for each topic
const categoryExpertise: Record<string, { intro: string; bullets: string[] }> = {
  Travel: {
    intro:
      'Travel coverage focuses on making every journey practical, affordable, and memorable — from first-time trips to seasoned adventures.',
    bullets: [
      'Destination guides covering popular and off-beat locations across Asia, Europe, and beyond',
      'Budget travel tips and cost-saving hacks for domestic and international trips',
      'Solo travel advice including safety, itinerary planning, and accommodation picks',
      'Honeymoon, couple, and family travel ideas with destination recommendations',
      'Practical guides covering visa requirements, packing lists, and flight booking tips',
      'Adventure travel, trekking routes, and outdoor experience guides',
    ],
  },
  Auto: {
    intro:
      'Auto coverage helps readers make smarter car decisions with honest, data-backed comparisons and ownership advice for Indian roads.',
    bullets: [
      'Car reviews covering performance, fuel efficiency, comfort, and real-world value',
      'Best mileage cars in India — petrol, diesel, CNG, and electric comparisons',
      'First-time buyer and upgrade guides across hatchback, sedan, and SUV segments',
      'Car maintenance tips: service intervals, tyre care, battery health, and running costs',
      'Electric vehicle (EV) and CNG car guides with charging, range, and cost breakdowns',
      'Latest auto industry news, upcoming launches, and price update coverage',
    ],
  },
  Beauty: {
    intro:
      'Beauty coverage is grounded in real products, proven ingredients, and skin-type-specific routines that work for everyday readers.',
    bullets: [
      'Skincare routines tailored for Indian skin — dry, oily, combination, and sensitive types',
      'Step-by-step makeup tutorials from 5-minute everyday looks to full occasion glam',
      'Ingredient breakdowns — niacinamide, retinol, vitamin C, hyaluronic acid, and SPF',
      'Acne treatment guides, dark spot removal tips, and skin barrier repair advice',
      'Trending beauty topics: skin cycling, slugging, barrier repair, and microbiome skincare',
      'Honest product reviews and best-of lists across drugstore and premium beauty brands',
    ],
  },
};

// Job title: DB column or derive from top category
const jobTitle =
  author.jobTitle ||
  (topCategory ? `${topCategory} Writer` : 'Contributing Writer');

// Writing since (year of oldest article)
const writingSince =
  posts && posts.length > 0
    ? new Date(posts[posts.length - 1].publishedAt ?? Date.now()).getFullYear()
    : null;

// sameAs links for schema
const sameAsLinks = [author.handleLink].filter(Boolean) as string[];

// ── SEO strings ────────────────────────────────────────────────────

const authorName = author.name || 'GlobalsBlog Author';
const authorBio =
  author.bio ||
  `${authorName} is a ${jobTitle} contributing practical, well-researched stories to GlobalsBlog across ${expertiseTags.slice(0, 3).join(', ')} and related topics.`;

const seoTitle = `${authorName} — ${jobTitle} at GlobalsBlog`;
const seoDescription =
  expertiseTags.length > 0
    ? `Read ${posts?.length ?? 0} articles by ${authorName}, ${jobTitle} at GlobalsBlog. Stories covering ${expertiseTags.slice(0, 3).join(', ')} and more.`
    : `Read articles by ${authorName} on GlobalsBlog. Browse published stories, author bio, and editorial expertise in one profile.`;

// ── Extended Person schema (supplements BaseHead schema) ──────────

const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : '';
const authorProfileUrl = `${siteUrl}/authors/${authorSlug}`;
const authorSchemaId = `${authorProfileUrl}#person`;

const extendedPersonSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': authorSchemaId,
  name: authorName,
  description: authorBio,
  jobTitle,
  ...(author.location ? { address: { '@type': 'PostalAddress', addressLocality: author.location } } : {}),
  ...(author.avatarUrl ? { image: { '@type': 'ImageObject', url: author.avatarUrl } } : {}),
  url: authorProfileUrl,
  worksFor: {
    '@type': 'Organization',
    name: 'GlobalsBlog',
    url: siteUrl || 'https://globalsblog.com',
  },
  knowsAbout: expertiseTags.length > 0 ? expertiseTags : expertiseAreas,
  ...(sameAsLinks.length > 0 ? { sameAs: sameAsLinks } : {}),
  mainEntityOfPage: {
    '@type': 'ProfilePage',
    '@id': authorProfileUrl,
  },
};
---

<Layout
  title={seoTitle}
  description={seoDescription}
  authorName={authorName}
  authorUrl={author.handleLink}
  authorBio={authorBio}
  authorAvatar={author.avatarUrl}
  isAuthorProfile={true}
>
  <!-- Extended Person schema (knowsAbout, jobTitle, sameAs, mainEntityOfPage) -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify(extendedPersonSchema)} />

  <!-- BREADCRUMB -->
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <ol>
      <li><a href="/">Home</a></li>
      <li aria-hidden="true">›</li>
      <li><a href="/#authors">Authors</a></li>
      <li aria-hidden="true">›</li>
      <li aria-current="page">{authorName}</li>
    </ol>
  </nav>

  <!-- AUTHOR HERO -->
  <section class="author-hero" id="person" itemscope itemtype="https://schema.org/Person">
    <div class="hero-avatar-col">
      {author.avatarUrl ? (
        <img
          src={author.avatarUrl}
          alt={`${authorName} — ${jobTitle} at GlobalsBlog`}
          width="200"
          height="200"
          loading="eager"
          fetchpriority="high"
          class="author-avatar"
          itemprop="image"
        />
      ) : (
        <div class="avatar-placeholder" aria-hidden="true">
          {authorName.charAt(0).toUpperCase()}
        </div>
      )}
      <span class="verified-badge">GlobalsBlog Author</span>
    </div>

    <div class="hero-info">
      <p class="eyebrow">Author profile</p>
      <h1 itemprop="name">{authorName}</h1>
      <p class="author-jobtitle" itemprop="jobTitle">{jobTitle} at GlobalsBlog</p>

      {author.location && (
        <p class="author-location" itemprop="address">
          <span aria-label="Location">📍</span> {author.location}
        </p>
      )}

      <p class="author-bio" itemprop="description">{authorBio}</p>

      {expertiseTags.length > 0 && (
        <div class="expertise-tags" aria-label="Topics this author covers">
          {expertiseTags.map((tag) => (
            <span class="expertise-tag">{tag}</span>
          ))}
        </div>
      )}

      <div class="author-links">
        <a href="#articles" class="btn-primary">
          View {posts?.length ?? 0} articles
        </a>
        {author.handleLink && (
          <a
            href={author.handleLink}
            target="_blank"
            rel="noopener noreferrer me"
            class="btn-social"
            aria-label={`${authorName} on ${author.twitterHandle || 'social media'}`}
            itemprop="sameAs"
          >
            {author.twitterHandle || 'Social profile'}
          </a>
        )}
      </div>
    </div>
  </section>

  <!-- CREDIBILITY STATS -->
  <div class="cred-strip" role="list" aria-label="Author credentials">
    <div role="listitem">
      <strong>{posts?.length ?? 0}</strong>
      <span>Published articles</span>
    </div>
    {writingSince && (
      <div role="listitem">
        <strong>Since {writingSince}</strong>
        <span>Writing for GlobalsBlog</span>
      </div>
    )}
    {topCategory && (
      <div role="listitem">
        <strong>{topCategory}</strong>
        <span>Top covered category</span>
      </div>
    )}
    {sortedCategories.length > 1 && (
      <div role="listitem">
        <strong>{sortedCategories.length}</strong>
        <span>Categories covered</span>
      </div>
    )}
    <div role="listitem">
      <strong>GlobalsBlog</strong>
      <span>Editorial platform</span>
    </div>
  </div>

  <!-- ARTICLES -->
  <section class="articles-section" id="articles" aria-labelledby="articles-heading">
    <div class="section-header">
      <div>
        <p class="eyebrow">By {authorName}</p>
        <h2 id="articles-heading">
          {posts?.length ?? 0} articles by {authorName} on GlobalsBlog
        </h2>
      </div>
    </div>

    {posts?.length ? (
      <div class="article-grid">
        {posts.map((post) => {
          const cat = post.category;
          const catSlug = cat?.slug || slugify(cat?.name || 'blog');
          return (
            <article class="article-card" itemprop="author" itemscope itemtype="https://schema.org/Article">
              <a href={`/${catSlug}/${post.slug}`}>
                {post.heroImage && (
                  <img
                    src={post.heroImage}
                    alt={post.title}
                    width="600"
                    height="338"
                    loading="lazy"
                  />
                )}
                <div class="card-body">
                  <span class="card-tag">{cat?.name ?? 'Story'}</span>
                  <h3 itemprop="headline">{post.title}</h3>
                  {post.description && <p>{post.description}</p>}
                  {post.publishedAt && (
                    <time class="card-date" datetime={post.publishedAt} itemprop="datePublished">
                      {formatDate(post.publishedAt)}
                    </time>
                  )}
                </div>
              </a>
            </article>
          );
        })}
      </div>
    ) : (
      <div class="empty-state">
        <h2>No published articles yet</h2>
        <p>This author profile is live. Articles will appear here as they are published.</p>
      </div>
    )}
  </section>

  <!-- WHAT THIS AUTHOR COVERS — per-category E-E-A-T content -->
  {sortedCategories.length > 0 && (
    <section class="coverage-section" aria-labelledby="coverage-heading">

      <div class="coverage-header">
        <div>
          <p class="eyebrow">Editorial expertise</p>
          <h2 id="coverage-heading">What {authorName} covers on GlobalsBlog</h2>
        </div>
        <p class="coverage-intro">
          {authorName} is a <strong>{jobTitle}</strong> contributing to GlobalsBlog
          {writingSince ? ` since ${writingSince}` : ''}. Their published work spans{' '}
          <strong>{sortedCategories.map(([name]) => name).join(', ')}</strong> with a focus on
          practical, well-researched content for everyday readers.
        </p>
      </div>

      <!-- Per-category expertise cards -->
      <div class="expertise-grid">
        {sortedCategories.map(([catName, count]) => {
          const exp = categoryExpertise[catName];
          if (!exp) return null;
          return (
            <div class="expertise-card">
              <div class="expertise-card-header">
                <div class="expertise-card-meta">
                  <strong class="expertise-cat-name">{catName}</strong>
                  <span class="expertise-article-count">
                    {count} {count === 1 ? 'article' : 'articles'}
                  </span>
                </div>
                <a
                  href={`/category/${catName.toLowerCase()}`}
                  class="expertise-browse-link"
                  aria-label={`Browse all ${catName} articles`}
                >
                  Browse {catName} →
                </a>
              </div>

              <p class="expertise-cat-intro">{exp.intro}</p>

              <ul class="expertise-bullets">
                {exp.bullets.map((bullet) => (
                  <li>
                    <span class="bullet-arrow" aria-hidden="true">→</span>
                    <span>{bullet}</span>
                  </li>
                ))}
              </ul>
            </div>
          );
        })}
      </div>

      <!-- Trust signals -->
      <div class="coverage-trust-row">
        <div class="trust-card">
          <p class="eyebrow">Editorial standards</p>
          <h3>About this author's work</h3>
          <p>
            All articles by {authorName} published on GlobalsBlog go through the site's editorial
            review process before going live. Content is original, factual, and written to be
            genuinely useful to readers in each topic area.
          </p>
          <a href="/about" class="trust-link">About GlobalsBlog →</a>
        </div>

        <div class="trust-card">
          <p class="eyebrow">Topics covered</p>
          <h3>{sortedCategories.length} {sortedCategories.length === 1 ? 'category' : 'categories'} — {posts?.length ?? 0} articles total</h3>
          <ul class="trust-cat-list">
            {sortedCategories.map(([catName, count]) => (
              <li>
                <a href={`/category/${catName.toLowerCase()}`}>
                  {catName}
                </a>
                <span>{count} {count === 1 ? 'article' : 'articles'}</span>
              </li>
            ))}
          </ul>
        </div>

        {author.handleLink && (
          <div class="trust-card">
            <p class="eyebrow">Follow {authorName}</p>
            <h3>Connect on {author.twitterHandle || 'social media'}</h3>
            <p>
              Follow {authorName} for updates on new articles, topic insights, and editorial
              work across {sortedCategories.map(([name]) => name).join(', ')}.
            </p>
            <a
              href={author.handleLink}
              target="_blank"
              rel="noopener noreferrer me"
              class="trust-link"
            >
              Follow on {author.twitterHandle || 'social media'} →
            </a>
          </div>
        )}
      </div>

    </section>
  )}

</Layout>

<style>
  /* ── Breadcrumb ── */
  .breadcrumb {
    margin-bottom: 1.2rem;
  }

  .breadcrumb ol {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.88rem;
    color: var(--muted);
    flex-wrap: wrap;
  }

  .breadcrumb a {
    color: var(--muted);
    text-decoration: none;
    transition: color 180ms;
  }

  .breadcrumb a:hover {
    color: var(--accent-strong);
  }

  .breadcrumb [aria-current="page"] {
    color: var(--ink-strong);
    font-weight: 600;
  }

  /* ── Author hero ── */
  .author-hero {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: start;
    padding: clamp(1.5rem, 4vw, 3rem);
    border: 1px solid var(--line);
    border-radius: var(--radius-xl);
    background:
      radial-gradient(circle at top right, rgba(182, 91, 46, 0.1), transparent 22rem),
      var(--card);
    box-shadow: var(--shadow-tight);
    margin-bottom: 1.2rem;
  }

  .hero-avatar-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    flex: 0 0 auto;
  }

  .author-avatar {
    width: 160px;
    height: 160px;
    border-radius: 50%;
    object-fit: cover;
    border: 4px solid var(--surface-strong);
    box-shadow: var(--shadow);
  }

  .avatar-placeholder {
    width: 160px;
    height: 160px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--accent), var(--accent-strong));
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 3.5rem;
    font-weight: 900;
    color: #fff7ef;
    border: 4px solid var(--surface-strong);
  }

  .verified-badge {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    background: rgba(182, 91, 46, 0.1);
    border: 1px solid rgba(182, 91, 46, 0.25);
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--accent-strong);
    text-align: center;
  }

  .eyebrow {
    margin-bottom: 0.5rem;
    font-size: 0.78rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .author-hero h1 {
    font-size: clamp(1.9rem, 4vw, 3rem);
    margin-bottom: 0.3rem;
    line-height: 1.1;
  }

  .author-jobtitle {
    font-size: 1rem;
    font-weight: 600;
    color: var(--accent-strong);
    margin-bottom: 0.5rem;
  }

  .author-location {
    font-size: 0.9rem;
    color: var(--muted);
    margin-bottom: 0.75rem;
  }

  .author-bio {
    font-size: 1.05rem;
    color: var(--muted);
    line-height: 1.7;
    max-width: 58rem;
    margin-bottom: 1.2rem;
  }

  .expertise-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.3rem;
  }

  .expertise-tag {
    display: inline-block;
    padding: 0.3rem 0.75rem;
    background: rgba(182, 91, 46, 0.08);
    border: 1px solid rgba(182, 91, 46, 0.2);
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--accent-strong);
    letter-spacing: 0.04em;
  }

  .author-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
  }

  .btn-primary,
  .btn-social {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 42px;
    padding: 0.6rem 1.1rem;
    border-radius: 999px;
    font-size: 0.9rem;
    font-weight: 700;
    text-decoration: none;
    transition: transform 180ms ease, opacity 180ms ease;
  }

  .btn-primary {
    background: var(--ink-strong);
    color: #fff7ef;
  }

  .btn-primary:hover {
    transform: translateY(-1px);
    opacity: 0.9;
  }

  .btn-social {
    background: transparent;
    color: var(--accent-strong);
    border: 1px solid var(--line);
  }

  .btn-social:hover {
    background: rgba(182, 91, 46, 0.06);
    transform: translateY(-1px);
  }

  /* ── Credibility stats ── */
  .cred-strip {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
    gap: 1rem;
    margin-bottom: 2.5rem;
  }

  .cred-strip > div {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 1rem 1.1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--card);
    box-shadow: var(--shadow-tight);
  }

  .cred-strip strong {
    font-size: 1.15rem;
    color: var(--ink-strong);
    line-height: 1.2;
  }

  .cred-strip span {
    font-size: 0.78rem;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  /* ── Articles section ── */
  .articles-section {
    margin-bottom: 2.5rem;
  }

  .section-header {
    margin-bottom: 1.4rem;
  }

  .section-header h2 {
    font-size: clamp(1.3rem, 2.5vw, 1.9rem);
    margin-bottom: 0;
  }

  .article-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.2rem;
  }

  .article-card a {
    display: block;
    height: 100%;
    overflow: hidden;
    text-decoration: none;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--card);
    box-shadow: var(--shadow-tight);
    color: inherit;
    transition: transform 180ms ease, box-shadow 180ms ease;
  }

  .article-card a:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow);
  }

  .article-card img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .card-body {
    display: grid;
    gap: 0.5rem;
    padding: 1.1rem 1.2rem 1.3rem;
  }

  .card-tag {
    font-size: 0.72rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--accent-strong);
    font-weight: 700;
  }

  .card-body h3 {
    margin: 0;
    font-size: 1.1rem;
    line-height: 1.3;
    color: var(--ink-strong);
  }

  .card-body p {
    margin: 0;
    font-size: 0.88rem;
    color: var(--muted);
    line-height: 1.55;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-date {
    font-size: 0.8rem;
    color: var(--muted);
  }

  .empty-state {
    padding: 2rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--card);
    text-align: center;
    color: var(--muted);
  }

  /* ── Coverage / E-E-A-T section ── */
  .coverage-section {
    padding: clamp(1.8rem, 4vw, 2.8rem);
    border: 1px solid var(--line);
    border-radius: var(--radius-xl);
    background:
      radial-gradient(circle at top left, rgba(210, 124, 67, 0.08), transparent 22rem),
      var(--card);
    box-shadow: var(--shadow-tight);
    margin-bottom: 1rem;
    display: grid;
    gap: 2rem;
  }

  .coverage-header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    gap: 2rem;
    align-items: start;
  }

  .coverage-header h2 {
    font-size: clamp(1.3rem, 2.5vw, 1.85rem);
    margin-bottom: 0;
    line-height: 1.2;
  }

  .coverage-intro {
    margin: 0;
    font-size: 0.97rem;
    color: var(--muted);
    line-height: 1.7;
    align-self: center;
  }

  /* Per-category expertise cards */
  .expertise-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.2rem;
