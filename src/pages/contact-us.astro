---
import Layout from '../layouts/Layout.astro';
---

<Layout
	title="Contact Us | GlobalsBlog"
	description="Contact GlobalsBlog for editorial, advertising, or business inquiries."
>
	<section class="content-page">
		<div class="content-hero">
			<p class="eyebrow">Contact GlobalsBlog</p>
			<h1>Get in touch for editorial, advertising, or business inquiries.</h1>
			<p class="lede">
				Readers, contributors, and brand partners can contact GlobalsBlog directly using the
				email below. We aim to respond to genuine inquiries as quickly as possible.
			</p>
		</div>

		<div class="contact-strip">
			<div>
				<strong>Email</strong>
				<p><a href="mailto:contact@globalsblog.com">contact@globalsblog.com</a></p>
			</div>
			<div>
				<strong>Location</strong>
				<p>Sector 48, Gurugram, Haryana, India</p>
			</div>
			<div>
				<strong>Coverage</strong>
				<p>Travel, Beauty, Auto, News, and general publishing queries</p>
			</div>
		</div>

		<div class="info-grid">
			<article class="info-card">
				<h2>What to contact us about</h2>
				<ul class="detail-list">
					<li>General feedback about the site or published articles</li>
					<li>Advertising and partnership inquiries</li>
					<li>Corrections, updates, or content-related questions</li>
					<li>Business communication regarding GlobalsBlog</li>
				</ul>
			</article>

			<article class="info-card content-card-accent">
				<h2>Response note</h2>
				<p>
					Please include clear details in your message so we can route it correctly. For urgent
					corrections or rights-related concerns, use the same official email address listed on
					this page.
				</p>
			</article>
		</div>
	</section>
</Layout>
